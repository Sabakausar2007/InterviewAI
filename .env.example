# ==== Database Configuration ====
# Used for your LOCAL Windows setup with MySQL. Leave these as-is for local use.
#
# NOTE FOR FREE ONLINE HOSTING (e.g. Render): do NOT add these DATABASE_*
# variables to the hosting platform's environment variables at all. If they
# are absent, the app automatically switches to a built-in SQLite database
# file instead, so it still works with zero database setup. See README.md
# "Deploying Online for Free" for exact steps.
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=root
DATABASE_PASSWORD=YOUR_PASSWORD
DATABASE_NAME=interview_ai

# ==== Security ====
# Any long random string. Change this before real use.
SECRET_KEY=change-this-super-secret-key-please
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==== AI API ====
# Leave blank to run in FALLBACK / DEMO mode (no AI, uses built-in question bank + rule-based scoring)
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# ==== App ====
APP_HOST=127.0.0.1
APP_PORT=8000
MAX_RESUME_SIZE_MB=5
